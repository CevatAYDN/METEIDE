{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"declaration": false,
		// packages/ui-theia is CommonJS and its classes use inversify's legacy decorators (ADR-002), and
		// this one project type-checks its tests with the others; Biome still asks for `import type`.
		"experimentalDecorators": true,
		"verbatimModuleSyntax": false,
		"types": ["node"]
	},
	"include": ["packages/*/test", "apps/*/test", "packages/*/vitest.config.ts"]
}
