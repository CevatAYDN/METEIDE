{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"declaration": false,
		// packages/ui-theia is CommonJS and its classes use inversify's legacy decorators (ADR-002), and
		// this one project type-checks its tests with the others; tsc no longer enforces `import type` there (Biome only warns).
		"experimentalDecorators": true,
		"verbatimModuleSyntax": false,
		// ui-theia tests import its TSX panels.
		"jsx": "react-jsx",
		"types": ["node"]
	},
	// The tests reach ui-theia's Flow view through its widget, which imports React Flow's stylesheet.
	"include": [
		"packages/*/test",
		"apps/*/test",
		"packages/*/vitest.config.ts",
		"packages/ui-theia/src/css.d.ts"
	]
}
