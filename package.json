{
	"name": "mete",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"author": "Fifty Three Studio <fiftythreestudio@gmail.com>",
	"packageManager": "pnpm@11.28.6",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "biome check . && tsc -b && tsc -p tsconfig.test.json && depcruise packages apps && pnpm test:scripts && turbo run test",
		"check:mcp": "pnpm build && node scripts/mcp-conformance.mjs",
		"test:chaos": "pnpm --filter @mete/cli build && pnpm --filter @mete/cli exec vitest run --config vitest.chaos.config.ts",
		"release:check": "node scripts/release-check.mjs",
		"test": "turbo run test",
		"test:scripts": "node --experimental-vm-modules --test scripts/test/maintenance.test.mjs scripts/test/license-metadata.test.mjs scripts/test/security-compatibility.test.mjs scripts/test/vendor-hardening.test.mjs",
		"build": "turbo run build",
		"test:record": "echo \"test:record is not built yet; provider tests use hand-written fetch fakes (docs/15)\" && exit 1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "3.0.3",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.5",
		"dependency-cruiser": "18.6.0",
		"lefthook": "2.2.2",
		"turbo": "2.11.8",
		"typescript": "6.0.3",
		"vitest": "5.0.5",
		"zod": "4.6.7"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.22.0",
			"onFail": "download"
		}
	}
}
