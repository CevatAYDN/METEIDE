{
	"name": "mete",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "biome check . && tsc -b && tsc -p tsconfig.test.json && depcruise packages apps && turbo run test",
		"test": "turbo run test",
		"build": "turbo run build",
		"test:record": "echo \"test:record arrives with the gateway (Phase 1)\" && exit 1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "3.0.3",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "24.19.1",
		"@vitest/coverage-v8": "5.0.3",
		"dependency-cruiser": "18.5.0",
		"lefthook": "2.2.0",
		"turbo": "2.11.7",
		"typescript": "6.0.3",
		"vitest": "5.0.3"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	}
}
