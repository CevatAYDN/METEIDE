{
	"extends": "../../tsconfig.base.json",
	// Theia loads extension modules with require and its classes use inversify's legacy decorators
	// (ADR-002): this package has no "type": "module", so NodeNext emits CommonJS, and
	// verbatimModuleSyntax would refuse an `export` in it.
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"verbatimModuleSyntax": false,
		"experimentalDecorators": true,
		// The panels are TSX on the automatic runtime; `react` is a dependency of this package and
		// the same copy Theia's @theia/core/shared/react re-exports (a peer of @theia/core).
		"jsx": "react-jsx"
	},
	"include": ["src"]
}
