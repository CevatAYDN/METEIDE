{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!docs", "!**/dist"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 10 }
				},
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": { "maxLines": 40 }
				},
				"useMaxParams": { "level": "error", "options": { "max": 4 } }
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"noDefaultExport": "error",
				"noEnum": "error",
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": { "maxLines": 400 }
				}
			},
			"nursery": {
				"noFloatingPromises": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/test/**", "packages/testing/**"],
			"linter": {
				"rules": {
					"complexity": { "noExcessiveLinesPerFunction": "off" },
					"style": { "noExcessiveLinesPerFile": "off" }
				}
			}
		},
		{
			"includes": [
				"**/vitest.config.ts",
				"**/vitest.config.mts",
				"**/vitest.*.config.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		}
	]
}
